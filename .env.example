# Sincronizacao na nuvem (opcional).
#
# Sem estas variaveis o app funciona normalmente, salvando tudo apenas
# no navegador (localStorage). Com elas, voce cria uma conta e acessa
# seu setup de qualquer dispositivo.
#
# Onde encontrar: painel do Supabase -> Project Settings -> API
#   NEXT_PUBLIC_SUPABASE_URL      = "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = chave "anon" / "publishable"
#
# A chave anon e publica por design: a protecao real vem das politicas
# de Row Level Security definidas em supabase/schema.sql.
# NUNCA use aqui a chave "service_role".

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
